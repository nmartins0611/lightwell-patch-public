<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CME Recommended Controls — {{ report.cve_id }}</title>
<style>
  :root {
    --rh-red: #ee0000;
    --rh-red-light: #ff442b;
    --bg: #151515;
    --surface: #1f1f1f;
    --surface-raised: #292929;
    --border: #3c3f42;
    --text: #e0e0e0;
    --text-secondary: #a3a3a3;
    --pass: #3e8635;
    --pass-light: #5ba352;
    --pass-bg: rgba(62, 134, 53, 0.12);
    --fail-light: #f56e6e;
    --warn: #f0ab00;
    --warn-bg: rgba(240, 171, 0, 0.10);
    --accent: #73bcf7;
    --font: 'Red Hat Display', 'Red Hat Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: var(--font); background: var(--bg); color: var(--text); padding: 2rem; line-height: 1.6; }
  .container { max-width: 1100px; margin: 0 auto; }
  header {
    display: flex; align-items: center; gap: 1rem;
    margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 3px solid var(--rh-red);
  }
  .logo {
    width: 40px; height: 40px; background: var(--rh-red); border-radius: 4px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: 1.1rem; color: white; flex-shrink: 0;
  }
  .header-text h1 { font-size: 1.6rem; font-weight: 700; color: #fff; }
  .header-meta { color: var(--text-secondary); font-size: 0.85rem; margin-top: 0.2rem; }
  .header-meta strong { color: var(--text); }
  .badge {
    margin-left: auto; padding: 0.25rem 0.75rem; border-radius: 4px;
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; background: rgba(115,188,247,0.12); color: var(--accent);
    border: 1px solid var(--accent);
  }
  .cve-hero {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 12px; padding: 1.5rem 2rem; margin-bottom: 1.5rem;
  }
  .cve-hero h2 { font-size: 1.35rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem; }
  .cve-desc { color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    display: inline-block; padding: 0.2rem 0.65rem; border-radius: 4px;
    font-size: 0.75rem; font-weight: 600;
    background: var(--surface-raised); border: 1px solid var(--border);
  }
  .chip code { color: var(--accent); font-size: 0.75rem; }
  .summary-cards {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem; margin-bottom: 2rem;
  }
  .stat {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 8px; padding: 1.25rem; text-align: center;
  }
  .stat .value { font-size: 2.25rem; font-weight: 800; color: var(--accent); }
  .stat .label {
    color: var(--text-secondary); font-size: 0.75rem; margin-top: 0.25rem;
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .section-title {
    font-size: 1.15rem; font-weight: 700; margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem; border-bottom: 2px solid var(--border); color: #fff;
  }
  .section-subtitle { font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem; }
  table {
    width: 100%; border-collapse: collapse; background: var(--surface);
    border-radius: 8px; overflow: hidden; border: 1px solid var(--border); margin-bottom: 1rem;
  }
  th {
    text-align: left; padding: 0.75rem 1rem; background: var(--surface-raised);
    color: var(--text-secondary); font-weight: 600; font-size: 0.75rem;
    text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border);
  }
  td { padding: 0.6rem 1rem; border-bottom: 1px solid var(--border); font-size: 0.875rem; }
  tr:last-child td { border-bottom: none; }
  .tactic-tag {
    display: inline-block; padding: 0.15rem 0.5rem; border-radius: 3px;
    font-size: 0.7rem; font-weight: 600; background: rgba(115,188,247,0.1); color: var(--accent);
  }
  .attenuation-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 0.75rem;
    display: flex; align-items: center; gap: 1rem;
  }
  .attenuation-card .metric-name { font-size: 1.1rem; font-weight: 800; color: var(--rh-red-light); min-width: 2.5rem; }
  .attenuation-card .arrow { color: var(--text-secondary); }
  .attenuation-card .value { font-size: 1.1rem; font-weight: 700; color: var(--pass-light); }
  .attenuation-card .controls { color: var(--text-secondary); font-size: 0.8rem; margin-left: auto; }
  .next {
    background: var(--pass-bg); border: 1px solid var(--pass);
    border-radius: 8px; padding: 1.25rem 1.5rem; margin: 2rem 0;
  }
  .next strong { color: var(--pass-light); }
  footer {
    margin-top: 3rem; padding-top: 1rem; border-top: 2px solid var(--rh-red);
    color: var(--text-secondary); font-size: 0.8rem;
    display: flex; justify-content: space-between; align-items: center;
  }
  footer .powered { color: var(--rh-red-light); font-weight: 600; }
</style>
</head>
<body>
<div class="container">
{% set total = report.controls | length %}
  <header>
    <div class="logo">CME</div>
    <div class="header-text">
      <h1>Recommended Controls</h1>
      <div class="header-meta">
        Source: <strong>{{ report.intel_source }}</strong>
        &nbsp;|&nbsp; {{ report.timestamp }}
      </div>
    </div>
    <span class="badge">Recommendation</span>
  </header>

  <div class="cve-hero">
    <h2>{{ report.cve_id }}</h2>
    {% if report.description | default('') | length > 0 %}
    <p class="cve-desc">{{ report.description | e }}</p>
    {% endif %}
    <div class="chips">
      {% if report.severity | default('') | length > 0 %}
      <span class="chip">{{ report.severity }} {{ report.base_score }}</span>
      {% endif %}
      {% if report.cvss_vector | length > 0 %}
      <span class="chip"><code>{{ report.cvss_vector }}</code></span>
      {% endif %}
      {% for cwe in report.cwe_ids %}
      <span class="chip">{{ cwe }}</span>
      {% endfor %}
    </div>
  </div>

  <div class="summary-cards">
    <div class="stat"><div class="value">{{ total }}</div><div class="label">Recommended</div></div>
    <div class="stat"><div class="value">{{ report.query_summary.matched_by_vector }}</div><div class="label">Matched by CVSS</div></div>
    <div class="stat"><div class="value">{{ report.query_summary.matched_by_cwe }}</div><div class="label">Matched by CWE</div></div>
  </div>

{% if report.attenuation | default([]) | length > 0 %}
  <div class="section-title">Projected CVSS Attenuation</div>
  <div class="section-subtitle">Metric shifts if every recommended control is active.</div>
{% for item in report.attenuation %}
  <div class="attenuation-card">
    <span class="metric-name">{{ item.metric }}</span>
    <span class="arrow">→</span>
    <span class="value">{{ item.modified_to }}</span>
    <span class="controls">{{ item.contributing_controls | join(', ') }}</span>
  </div>
{% endfor %}
{% endif %}

  <div class="section-title">Recommended Controls to Apply</div>
{% if total == 0 %}
  <p class="section-subtitle">No CME controls matched this CVE. Manual triage is required.</p>
{% else %}
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Control</th>
        <th>Tactic</th>
        <th>Category</th>
        <th>Layer</th>
        <th>Matched via</th>
      </tr>
    </thead>
    <tbody>
{% for c in report.controls %}
      <tr>
        <td><strong>{{ c.cme_id }}</strong></td>
        <td>{{ c.control_name }}</td>
        <td><span class="tactic-tag">{{ c.tactic | default('—') }}</span></td>
        <td>{{ c.category | default('—') }}</td>
        <td>{{ c.control_layer | default('—') }}</td>
        <td>{{ c.matched_via }}</td>
      </tr>
{% endfor %}
    </tbody>
  </table>
{% endif %}

  <div class="next">
    <strong>Next step:</strong> launch the <em>CME Mitigate</em> job template to apply these controls on the Demo Fleet. Then run <em>CME Verify</em> for the PRE/POST posture report.
  </div>

  <footer>
    <span>Lightwell Patch Demo &nbsp;|&nbsp; {{ report.cve_id }}</span>
    <span class="powered">Powered by Common Mitigation Enumeration</span>
  </footer>
</div>
</body>
</html>
